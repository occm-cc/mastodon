- content_for :page_title do
  = t('.title')

= simple_form_for @announcement, url: settings_announcements_path, html: { novalidate: false } do |form|
  = render 'shared/error_messages', object: @announcement

  = render 'admin/announcements/form', form: form

  .actions
    = form.button :button,
                  t('admin.announcements.new.create'),
                  type: :submit
